<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <ImageButton
        android:id="@+id/np_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_close"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/on_surface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/now_playing_title"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="@color/on_surface_muted"
        app:layout_constraintStart_toEndOf="@id/np_close"
        app:layout_constraintEnd_toStartOf="@id/np_queue"
        app:layout_constraintTop_toTopOf="@id/np_close"
        app:layout_constraintBottom_toBottomOf="@id/np_close" />

    <ImageButton
        android:id="@+id/np_queue"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_queue"
        android:src="@drawable/ic_queue"
        app:tint="@color/on_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/np_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/queue_empty"
        android:textColor="@color/on_surface_muted"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/np_close"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ViewFlipper
        android:id="@+id/np_flipper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/np_close"
        app:layout_constraintBottom_toTopOf="@id/np_controls_block"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Page 0: artwork -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/np_artwork"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/cd_now_playing_artwork"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_artwork_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.RidhoMusic.Artwork"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/np_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0.35" />

            <TextView
                android:id="@+id/np_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/on_surface"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/np_artwork"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/np_artist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/secondary_text_teal"
                app:layout_constraintTop_toBottomOf="@id/np_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/np_artist"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/np_favorite"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_favorite"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="@color/primary" />

                <ImageButton
                    android:id="@+id/np_lyrics_toggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_lyrics"
                    android:src="@drawable/ic_lyrics"
                    app:tint="@color/on_surface" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Page 1: lyrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/np_lyrics_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="40dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/np_lyrics_plain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:lineSpacingExtra="6dp"
                android:scrollbars="vertical"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/np_lyrics_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/lyrics_none"
                android:textColor="@color/on_surface_muted"
                android:visibility="gone" />
        </LinearLayout>
    </ViewFlipper>

    <!-- Controls -->
    <LinearLayout
        android:id="@+id/np_controls_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.slider.Slider
            android:id="@+id/np_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.1"
            android:valueFrom="0.0"
            android:valueTo="100.0"
            app:labelBehavior="gone"
            app:thumbColor="@color/primary"
            app:tickVisible="false"
            app:trackColorActive="@color/primary"
            app:trackColorInactive="@color/player_scrubber_track" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/np_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/np_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_duration_unknown"
                android:textColor="@color/on_surface_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/np_shuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_shuffle"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/on_surface" />

            <Space android:layout_width="14dp" android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/np_prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_previous"
                android:src="@drawable/ic_prev"
                app:tint="@color/on_surface" />

            <Space android:layout_width="14dp" android:layout_height="1dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/np_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_play"
                android:src="@drawable/ic_play"
                app:backgroundTint="@color/primary"
                app:elevation="0dp"
                app:fabSize="normal"
                app:tint="@color/on_primary" />

            <Space android:layout_width="14dp" android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/np_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_next"
                android:src="@drawable/ic_next"
                app:tint="@color/on_surface" />

            <Space android:layout_width="14dp" android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/np_repeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_repeat"
                android:src="@drawable/ic_repeat"
                app:tint="@color/on_surface" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
